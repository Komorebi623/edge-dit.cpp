4f\u7b2c\u4e09\u6839\u7684\u5c16\u7aef\u3002\u5979\u62ac\u773c\u770b\u5411\u524d\u65b9\uff0c\u7709\u5934\u538b\u4f4e\u3001\u4e0b\u988c\u6536\u7d27\uff0c\u8fb9\u8dd1\u8fb9\u6e05\u6670\u8bf4\uff1a\u201c\u90fd\u7ed9\u6211\u8ba9\u5f00\uff01\u201d\u53e3\u578b\u9010\u5b57\u540c\u6b65\u3002\u753b\u9762\u4e2d\u6ca1\u6709\u7b2c\u4e8c\u4e2a\u4eba\u3002[03.0-04.9\u79d2\uff5c\u955c\u59343\uff5c\u6839\u77db\u9636\u68af]\u5207\u523024mm\u77ed\u6682\u9ad8\u4f4d\u4fef\u62cd\u3002\u516d\u6839\u7c97\u58ee\u6839\u77db\u6cbf\u9053\u8def\u7531\u540e\u5411\u524d\u4f9d\u6b21\u523a\u51fa\uff0c\u5f62\u6210\u4e0d\u65ad\u62ac\u9ad8\u7684\u952f\u9f7f\u72b6\u969c\u788d\u3002\u5973\u4e3b\u59cb\u7ec8\u671d\u57fa\u5730\u51b2\u523a\uff0c\u5148\u8e0f\u4e0a\u7b2c\u4e00\u6839\u6b63\u5728\u4e0a\u5347\u7684\u6839\u77db\u501f\u529b\u8dc3\u8d77\uff0c\u7a7a\u4e2d\u6536\u817f\u907f\u5f00\u4ea4\u53c9\u523a\u5c16\uff0c\u843d\u5728\u7b2c\u4e09\u6839\u5f2f\u66f2\u6839\u987b\u4e0a\u540e\u7acb\u523b\u524d\u7ffb\uff0c\u6700\u540e\u4ece\u4e24\u6839\u5408\u62e2\u7684\u6839\u77db\u4e4b\u95f4\u7a7f\u51fa\u3002\u6839\u77db\u53ea\u4ece\u5730\u9762\u751f\u957f\uff0c\u6ca1\u6709\u4eba\u7269\u6216\u4eba\u5f62\u654c\u4eba\uff0c\u955c\u5934\u672b\u5c3e\u57fa\u5730\u5927\u95e8\u660e\u663e\u53d8\u8fd1\u3002[04.9-06.8\u79d2\uff5c\u955c\u59344\uff5c\u7ede\u7d22\u4e0e\u85e4\u7b3c]35mm\u4fa7\u5411\u8ddf\u62cd\u3002\u7ec6\u957f\u7ede\u7d22\u85e4\u4ece\u6811\u51a0\u5782\u4e0b\uff0c\u5148\u540e\u5957\u5411\u5973\u4e3b\u624b\u8155\u3001\u811a\u8e1d\u548c\u8170\u90e8\uff1b\u5979\u7528\u65cb\u8eab\u3001\u62ac\u819d\u548c\u8d34\u5730\u4fa7\u6eda\u8fde\u7eed\u907f\u5f00\u3002\u56db\u5468\u66f4\u591a\u7ec6\u85e4\u5728\u5979\u524d\u65b9\u8fc5\u901f\u7f16\u7ec7\u6210\u7403\u5f62\u85e4\u7b3c\uff0c\u5165\u53e3\u53ea\u5269\u4e00\u9053\u72ed\u7a84\u7f1d\u9699\u3002\u5973\u4e3b\u8e29\u4f4f\u4e00\u6839\u6536\u7d27\u7684\u85e4\u7d22\uff0c\u5229\u7528\u5b83\u7684\u56de\u5f39\u529b\u7eb5\u8eab\u524d\u8dc3\uff0c\u8eab\u4f53\u4fa7\u8f6c\u7a7f\u8fc7\u7f1d\u9699\uff0c\u767d\u8272\u957f\u9774\u64e6\u65ad\u4e24\u6839\u7ec6\u85e4\uff0c\u843d\u5730\u540e\u7ee7\u7eed\u5411\u524d\u8dd1\u3002\u85e4\u7b3c\u7531\u7eaf\u690d\u7269\u7ea4\u7ef4\u6784\u6210\uff0c\u4e0d\u5f62\u6210\u8138\u3001\u624b\u6216\u4eba\u4f53\u8f6e\u5ed3\u3002[06.8-08.3\u79d2\uff5c\u955c\u59345\uff5c\u6355\u6349\u7f51\u6536\u7d27]70mm\u79fb\u52a8\u4e2d\u666f\u3002\u7c97\u85e4\u4ece\u5730\u9762\u62ac\u8d77\uff0c\u7ec6\u85e4\u4ece\u6811\u51a0\u843d\u4e0b\uff0c\u4e24\u5c42\u85e4\u8513\u4ea4\u7ec7\u6210\u524d\u540e\u5939\u51fb\u7684\u6355\u6349\u7f51\u3002\u5973\u4e3b\u521a\u8d8a\u8fc7\u7b2c\u4e00\u5c42\uff0c\u7b2c\u4e8c\u5c42\u77ac\u95f4\u7f20\u4f4f\u5979\u7684\u5de6\u524d\u81c2\u3001\u53f3\u9774\u548c\u62ab\u98ce\u8fb9\u7f18\uff0c\u628a\u5979\u5411\u540e\u62c9\u5230\u5355\u819d\u7740\u5730\u3002\u955c\u5934\u7ed5\u5230\u6b63\u9762\uff0c\u5468\u56f4\u53ea\u6709\u6536\u7d27\u7684\u85e4\u7f51\u548c\u4e0d\u65ad\u903c\u8fd1\u7684\u523a\u5c16\u3002\u5979\u77ed\u4fc3\u5438\u6c14\uff0c\u624b\u6307\u5148\u56e0\u75bc\u75db\u6536\u7d27\uff0c\u968f\u540e\u62ac\u773c\uff0c\u795e\u60c5\u7531\u53d7\u538b\u8f6c\u4e3a\u51b7\u9759\u72e0\u5389\u3002\u5168\u666f\u548c\u8fd1\u666f\u4e2d\u90fd\u53ea\u6709\u5973\u4e3b\u4e00\u4eba\u3002[08.3-10.7\u79d2\uff5c\u955c\u59346\uff5c\u70b9\u706b\u711a\u7f51]85mm\u5973\u4e3b\u9762\u90e8\u4e0e\u53f3\u624b\u7279\u5199\uff0c\u7126\u70b9\u4ece\u52d2\u7d27\u624b\u8155\u7684\u9752\u7eff\u85e4\u8109\u8f6c\u5230\u5979\u7684\u773c\u775b\u3002\u5979\u53f3\u624b\u4ece\u5de6\u8170\u51c6\u786e\u53d6\u4e0b\u552f\u4e00\u70bc\u91d1\u74f6\uff0c\u62c7\u6307\u538b\u4e0b\u9ec4\u94dc\u6263\uff0c\u74f6\u5185\u7eff\u8272\u6db2\u4f53\u4ece\u5e95\u90e8\u8fc5\u901f\u8f6c\u4e3a\u91d1\u6a59\u8272\u706b\u7130\u3002\u5979\u76ef\u7740\u524d\u65b9\u4e0d\u65ad\u6536\u7d27\u7684\u85e4\u7f51\uff0c\u5e26\u7740\u514b\u5236\u7684\u6311\u8845\u6e05\u6670\u8bf4\uff1a\u201c\u518d\u62e6\u6211\uff0c\u6211\u5c31\u70e7\u4e86\u4f60\u4eec\u7684\u85e4\u5de2\uff01\u201d\u53e3\u578b\u5b8c\u6574\uff0c\u6700\u540e\u4e00\u4e2a\u5b57\u843d\u4e0b\u65f6\u74f6\u53e3\u55b7\u51fa\u7b2c\u4e00\u7f15\u706b\u7ebf\u3002\u706b\u7ebf\u51c6\u786e\u843d\u5728\u7f20\u4f4f\u53f3\u9774\u7684\u85e4\u8513\u4e0a\uff0c\u5e76\u6cbf\u9752\u7eff\u8272\u53d1\u5149\u8109\u7edc\u5411\u6574\u5f20\u6355\u6349\u7f51\u4f20\u64ad\u3002\u6ca1\u6709\u53cd\u6d3e\u7279\u5199\uff0c\u6ca1\u6709\u4efb\u4f55\u4eba\u56de\u5e94\u3002[10.7-12.5\u79d2\uff5c\u955c\u59347\uff5c\u65cb\u8f6c\u85e4\u5899\u5d29\u88c2]28mm\u8d34\u5730\u8ddf\u62cd\u3002\u5973\u4e3b\u501f\u71c3\u70e7\u65ad\u85e4\u7684\u56de\u5f39\u529b\u8d77\u8eab\u7ee7\u7eed\u5411\u524d\uff0c\u524d\u65b9\u6570\u5341\u6839\u7c97\u85e4\u76d8\u65cb\u4ea4\u7ec7\u6210\u4e00\u5835\u9ad8\u901f\u65cb\u8f6c\u7684\u5706\u5f62\u85e4\u5899\uff0c\u4e2d\u5fc3\u5b54\u6d1e\u4e0d\u65ad\u6536\u7f29\u3002\u5979\u628a\u706b\u7130\u74f6\u8d34\u8fd1\u53f3\u4fa7\u4e3b\u6839\uff0c\u91d1\u6a59\u706b\u7130\u6cbf\u6728\u8d28\u7ea4\u7ef4\u73af\u5f62\u6269\u6563\uff0c\u65cb\u8f6c\u85e4\u5899\u7531\u53f3\u5411\u5de6\u4f9d\u6b21\u7ef7\u65ad\uff0c\u7206\u6563\u6728\u5c51\u3001\u98de\u53f6\u548c\u706b\u661f\u3002\u5973\u4e3b\u5728\u5899\u4f53\u5d29\u88c2\u7684\u77ac\u95f4\u4ece\u4e2d\u5fc3\u7a7f\u51fa\uff0c\u843d\u5730\u540e\u5408\u4e0a\u74f6\u6263\uff0c\u706b\u7130\u7184\u706d\uff0c\u628a\u552f\u4e00\u70bc\u91d1\u74f6\u91cd\u65b0\u6302\u56de\u5de6\u8170\uff0c\u4e09\u6b65\u51b2\u4e0a\u57fa\u5730\u53f0\u9636\u3002\u76f4\u523012.5\u79d2\u8fd9\u4e00\u955c\u7ed3\u675f\uff0c\u57fa\u5730\u6b63\u95e8\u524d\u4ecd\u53ea\u6709\u5973\u4e3b\uff0c\u6ca1\u6709\u5176\u4ed6\u4eba\u7269\u3002[12.5-15.0\u79d2\uff5c\u955c\u59348\uff5c\u5b88\u95e8\u4eba\u9996\u6b21\u73b0\u8eab]\u52a8\u4f5c\u5339\u914d\u5207\u523035mm\u57fa\u5730\u95e8\u53e3\u4f4e\u673a\u4f4d\u3002\u9752\u7eff\u8272\u80fd\u91cf\u5c01\u5370\u4ece\u4e2d\u592e\u88c2\u5f00\u4e00\u9053\u7a84\u7f1d\uff0c\u552f\u4e00\u53cd\u6d3e\u8346\u68d8\u5b88\u95e8\u4eba\u6b64\u523b\u624d\u7b2c\u4e00\u6b21\u4ece\u95e8\u5185\u9634\u5f71\u4e2d\u8e0f\u51fa\uff0c\u753b\u9762\u4e2d\u53ea\u6709\u5973\u4e3b\u548c\u4ed6\u4e24\u4e2a\u4eba\u3002\u4ed6\u53cc\u624b\u63e1\u4f4f\u552f\u4e00\u9ed1\u6728\u957f\u6756\uff0c\u7531\u53f3\u4e0a\u5411\u5de6\u4e0b\u5b8c\u6210\u4e00\u6b21\u6c89\u91cd\u659c\u5288\uff1b\u5973\u4e3b\u4fdd\u6301\u524d\u51b2\u65b9\u5411\uff0c\u5411\u5de6\u4fa7\u8eab\u8ba9\u6756\u5934\u64e6\u8fc7\u80a9\u524d\uff0c\u5de6\u624b\u6293\u4f4f\u6756\u8eab\u4e2d\u6bb5\uff0c\u53f3\u811a\u51c6\u786e\u8e22\u4e2d\u4ed6\u63e1\u6756\u7684\u624b\u8155\u3002\u957f\u6756\u6ca1\u6709\u590d\u5236\uff0c\u53ea\u5728\u4ed6\u624b\u4e2d\u504f\u8f6c\u3002\u5b88\u95e8\u4eba\u987a\u52bf\u7528\u5de6\u8098\u8fd1\u8eab\u53cd\u51fb\uff0c\u5973\u4e3b\u62ac\u8d77\u53f3\u524d\u81c2\u683c\u6321\uff0c\u65cb\u8eab\u7528\u80a9\u90e8\u628a\u4ed6\u649e\u5411\u95e8\u4fa7\u6839\u5899\uff0c\u4ece\u4ed6\u8eab\u65c1\u8de8\u4e0a\u6700\u540e\u4e00\u7ea7\u53f0\u9636\u3002\u6444\u5f71\u673a\u5feb\u901f\u540e\u62c9\u621024mm\u5927\u5168\u666f\uff0c\u524d\u666f\u662f\u71c3\u70e7\u7684\u65ad\u85e4\uff0c\u4e2d\u666f\u53ea\u6709\u6b63\u5728\u5bf9\u5cd9\u7684\u5973\u4e3b\u4e0e\u552f\u4e00\u53cd\u6d3e\uff0c\u80cc\u666f\u5de8\u6811\u57fa\u5730\u6b63\u95e8\u5360\u6ee1\u753b\u9762\u4e0a\u534a\u90e8\u3002\u7ed3\u5c3e\u505c\u5728\u5973\u4e3b\u9762\u5bf9\u57fa\u5730\u5165\u53e3\u3001\u53cd\u6d3e\u5728\u4fa7\u65b9\u91cd\u65b0\u7a33\u4f4f\u8eab\u4f53\u7684\u6218\u6597\u59ff\u6001\u3002\u5bf9\u767d\uff1a\u5168\u7247\u53ea\u6709\u5973\u4e3b\u4e24\u53e5\u4e2d\u6587\u666e\u901a\u8bdd\u5bf9\u767d\u3002\u7b2c\u4e00\u53e5\u201c\u90fd\u7ed9\u6211\u8ba9\u5f00\uff01\u201d\u8bed\u6c14\u76f4\u63a5\u3001\u950b\u5229\uff0c\u662f\u5bf9\u5c01\u8def\u85e4\u8513\u7684\u8b66\u544a\uff1b\u7b2c\u4e8c\u53e5\u201c\u518d\u62e6\u6211\uff0c\u6211\u5c31\u70e7\u4e86\u4f60\u4eec\u7684\u85e4\u5de2\uff01\u201d\u8bed\u6c14\u514b\u5236\u3001\u5e26\u6311\u8845\u548c\u5fc5\u80dc\u628a\u63e1\u3002\u53cd\u6d3e\u6ca1\u6709\u53f0\u8bcd\uff0c\u85e4\u8513\u4e0d\u53d1\u51fa\u4eba\u58f0\uff0c\u65e0\u65c1\u767d\u3001\u65e0\u989d\u5916\u558a\u53eb\uff0c\u53e3\u578b\u9010\u5b57\u540c\u6b65\uff0c\u6253\u6597\u97f3\u6548\u4e0d\u906e\u76d6\u53f0\u8bcd\u3002\u58f0\u97f3\uff1a\u539f\u521b\u9ad8\u901f\u5e7b\u60f3\u6253\u51fb\u4e50\uff0c\u4f4e\u6c89\u6218\u9f13\u3001\u6728\u8d28\u6572\u51fb\u4e0e\u5f26\u4e50\u8109\u51b2\u6301\u7eed\u52a0\u901f\uff1b\u52a0\u5165\u6025\u4fc3\u811a\u6b65\u3001\u62ab\u98ce\u98ce\u58f0\u3001\u85e4\u8513\u7834\u571f\u3001\u7c97\u85e4\u62bd\u51fb\u3001\u786c\u523a\u64e6\u8fc7\u5e03\u6599\u3001\u6839\u77db\u7206\u571f\u3001\u7ede\u7d22\u6536\u7d27\u3001\u85e4\u7b3c\u7f16\u7ec7\u3001\u9774\u5e95\u6ed1\u5730\u3001\u9ec4\u94dc\u6263\u6309\u4e0b\u3001\u6db2\u4f53\u70b9\u71c3\u3001\u706b\u7130\u6cbf\u6728\u7ea4\u7ef4\u4f20\u64ad\u3001\u65cb\u8f6c\u85e4\u5899\u5d29\u88c2\u3001\u9ed1\u6728\u957f\u6756\u7834\u98ce\u3001\u624b\u8155\u53d7\u51fb\u3001\u524d\u81c2\u683c\u6321\u548c\u57fa\u5730\u5c01\u5370\u5f00\u542f\u58f0\u3002\u955c\u59346\u97f3\u4e50\u77ed\u6682\u964d\u4f4e\uff0c\u53ea\u4fdd\u7559\u547c\u5438\u3001\u85e4\u7f51\u6536\u7d27\u548c\u5973\u4e3b\u53f0\u8bcd\uff1b\u955c\u59347\u968f\u706b\u7130\u7206\u53d1\u8fdb\u5165\u6700\u5f3a\u91cd\u62cd\uff1b\u955c\u59348\u7528\u957f\u6756\u649e\u51fb\u548c\u8fd1\u8eab\u683c\u6321\u7684\u4f4e\u9891\u51b2\u51fb\u6536\u675f\u3002\u8fde\u7eed\u6027\u9501\u5b9a\uff1a\u955c\u59341\u81f3\u955c\u59347\u53ea\u6709\u5973\u4e3b\u4e00\u540d\u4eba\u7269\uff0c\u53cd\u6d3e\u53ea\u80fd\u5728\u955c\u59348\u768412.5\u79d2\u4ee5\u540e\u9996\u6b21\u51fa\u73b0\uff1b\u5168\u7247\u771f\u5b9e\u4eba\u7269\u603b\u6570\u59cb\u7ec8\u53ea\u6709\u5973\u4e3b\u4e0e\u552f\u4e00\u53cd\u6d3e\u4e24\u4eba\uff0c\u4efb\u4f55\u955c\u5934\u4e0d\u5f97\u51fa\u73b0\u7b2c\u4e09\u4e2a\u4eba\u3002\u5973\u4e3b\u7684\u8138\u3001\u68d5\u8272\u9ad8\u9a6c\u5c3e\u3001\u53f6\u7247\u91d1\u9970\u3001\u9f20\u5c3e\u8349\u7eff\u77ed\u62ab\u98ce\u3001\u5976\u767d\u4e0a\u8863\u3001\u767d\u8272\u77ed\u88e4\u3001\u6df1\u68d5\u4e1d\u889c\u3001\u767d\u8272\u957f\u9774\u