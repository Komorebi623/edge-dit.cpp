{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/THU-MIG/edge-dit.cpp/benchmark/schemas/environment.schema.json",
  "title": "edge-dit.cpp benchmark environment metadata",
  "type": "object",
  "additionalProperties": true,
  "required": ["schema_version", "timestamp_utc", "hardware", "software", "repositories"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "timestamp_utc": { "type": "string", "minLength": 1 },
    "hardware": {
      "type": "object",
      "additionalProperties": true,
      "required": ["gpus"],
      "properties": {
        "gpus": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["index", "name", "memory_total_mib"],
            "properties": {
              "index": { "type": "integer", "minimum": 0 },
              "name": { "type": "string" },
              "memory_total_mib": { "type": "integer", "minimum": 0 },
              "driver_version": { "type": ["string", "null"] }
            }
          }
        },
        "gpu_topology": { "type": ["string", "null"] }
      }
    },
    "software": {
      "type": "object",
      "additionalProperties": true,
      "properties": {
        "cuda": { "type": ["string", "null"] },
        "cudnn": { "type": ["string", "null"] },
        "nccl": { "type": ["string", "null"] },
        "mpi": { "type": ["string", "null"] },
        "python": { "type": ["string", "null"] },
        "torch": { "type": ["string", "null"] },
        "diffusers": { "type": ["string", "null"] },
        "transformers": { "type": ["string", "null"] }
      }
    },
    "repositories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": true,
        "required": ["commit"],
        "properties": {
          "path": { "type": ["string", "null"] },
          "commit": { "type": "string" },
          "dirty": { "type": ["boolean", "null"] },
          "branch": { "type": ["string", "null"] }
        }
      }
    }
  }
}
