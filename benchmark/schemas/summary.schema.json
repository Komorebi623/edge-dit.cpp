{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/THU-MIG/edge-dit.cpp/benchmark/schemas/summary.schema.json",
  "title": "edge-dit.cpp benchmark summary",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "suite_id", "generated_at_utc", "results"],
  "properties": {
    "schema_version": { "type": "integer", "minimum": 1 },
    "suite_id": { "type": "string", "minLength": 1 },
    "generated_at_utc": { "type": "string", "minLength": 1 },
    "results": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "suite",
          "system",
          "workload",
          "model",
          "task",
          "scenario",
          "status",
          "parallel_mode",
          "gpu_count",
          "run_options",
          "load_ms",
          "steady_state_median_ms",
          "steady_state_p90_ms",
          "coefficient_of_variation",
          "text_encoder_ms",
          "dit_ms",
          "vae_ms",
          "per_step_avg_ms",
          "peak_vram_mib",
          "peak_host_rss_mib",
          "speedup",
          "scaling_efficiency",
          "communication_ms",
          "all_to_all_ms",
          "packing_ms",
          "receive_preparation_ms",
          "graph_segment_count",
          "metric_source",
          "measurement_boundary",
          "quality_reference",
          "psnr",
          "ssim",
          "lpips",
          "clip",
          "image_reward",
          "cache_events",
          "sample_output_dir"
        ],
        "properties": {
          "suite": { "type": "string" },
          "system": { "type": "string" },
          "workload": { "type": "string" },
          "model": { "type": ["string", "null"] },
          "task": {
            "type": ["string", "null"],
            "enum": ["text-to-image", "image-editing", "text-to-video", null]
          },
          "scenario": { "type": "string" },
          "status": {
            "type": "string",
            "enum": ["success", "failed", "unsupported", "skipped"]
          },
          "parallel_mode": { "type": ["string", "null"] },
          "gpu_count": { "type": "integer", "minimum": 1 },
          "run_options": { "type": "object" },
          "load_ms": { "type": ["number", "null"], "minimum": 0 },
          "steady_state_median_ms": { "type": ["number", "null"], "minimum": 0 },
          "steady_state_p90_ms": { "type": ["number", "null"], "minimum": 0 },
          "coefficient_of_variation": { "type": ["number", "null"], "minimum": 0 },
          "text_encoder_ms": { "type": ["number", "null"], "minimum": 0 },
          "dit_ms": { "type": ["number", "null"], "minimum": 0 },
          "vae_ms": { "type": ["number", "null"], "minimum": 0 },
          "per_step_avg_ms": { "type": ["number", "null"], "minimum": 0 },
          "peak_vram_mib": { "type": ["number", "null"], "minimum": 0 },
          "peak_host_rss_mib": { "type": ["number", "null"], "minimum": 0 },
          "speedup": { "type": ["number", "null"], "minimum": 0 },
          "scaling_efficiency": { "type": ["number", "null"], "minimum": 0 },
          "communication_ms": { "type": ["number", "null"], "minimum": 0 },
          "all_to_all_ms": { "type": ["number", "null"], "minimum": 0 },
          "packing_ms": { "type": ["number", "null"], "minimum": 0 },
          "receive_preparation_ms": { "type": ["number", "null"], "minimum": 0 },
          "graph_segment_count": {
            "type": ["integer", "null"],
            "minimum": 0
          },
          "metric_source": { "type": ["string", "null"] },
          "measurement_boundary": { "type": ["string", "null"] },
          "quality_reference": { "type": ["string", "null"] },
          "psnr": { "type": ["number", "null"], "minimum": 0 },
          "ssim": { "type": ["number", "null"], "minimum": 0 },
          "lpips": { "type": ["number", "null"], "minimum": 0 },
          "clip": { "type": ["number", "null"], "minimum": 0 },
          "image_reward": { "type": ["number", "null"], "minimum": 0 },
          "cache_events": { "type": "array" },
          "sample_output_dir": { "type": ["string", "null"] }
        }
      }
    }
  }
}
