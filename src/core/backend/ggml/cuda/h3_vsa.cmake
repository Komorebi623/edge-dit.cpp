# Separate opt-in from SubBlock: both can be built without enabling either at runtime.
include_guard(GLOBAL)
option(ED_ENABLE_CUDA_H3_VSA "Build H3-only BF16 tile64 VSA CUDA primitives" OFF)
if(NOT ED_ENABLE_CUDA_H3_VSA)
    return()
endif()
if(NOT ED_GGML_CUDA OR NOT TARGET ggml-cuda OR NOT TARGET edgedit OR ED_GGML_HIP)
    message(FATAL_ERROR "H3 VSA requires NVIDIA CUDA and existing targets")
endif()
get_filename_component(_vsa_root "${CMAKE_CURRENT_LIST_DIR}/../../../../.." ABSOLUTE)
set(_vsa_original "${_vsa_root}/third_party/ggml/src/ggml-cuda/ggml-cuda.cu")
file(SHA256 "${_vsa_original}" _vsa_sha)
if(NOT _vsa_sha STREQUAL "1284940278a57c529b88ba4a3b4f49a82cf431fea63848bfb74d9e7f1f6ee265")
    message(FATAL_ERROR "H3 VSA fixed dispatcher SHA256 mismatch")
endif()
set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS "${_vsa_original}")
# Chain after the existing verified build-local SubBlock copy, or start from
# fixed ggml if SubBlock is disabled. Never discard another feature's hooks.
if(ED_ENABLE_CUDA_H3_SUBBLOCK)
    set(_vsa_input "${CMAKE_CURRENT_BINARY_DIR}/h3-subblock-generated/ggml-cuda.cu")
    if(NOT EXISTS "${_vsa_input}" OR NOT DEFINED _h3_generated_sha)
        message(FATAL_ERROR "H3 VSA must be included after verified SubBlock generation")
    endif()
    file(SHA256 "${_vsa_input}" _vsa_input_sha)
    if(NOT _vsa_input_sha STREQUAL _h3_generated_sha)
        message(FATAL_ERROR "H3 VSA prior generated dispatcher SHA256 mismatch")
    endif()
else()
    set(_vsa_input "${_vsa_original}")
    set(_vsa_input_sha "${_vsa_sha}")
endif()
file(READ "${_vsa_input}" _vsa_text)
function(_vsa_replace_once out text anchor replacement)
    string(FIND "${text}" "${anchor}" first)
    if(first LESS 0)
        message(FATAL_ERROR "H3 VSA missing dispatcher anchor")
    endif()
    string(LENGTH "${anchor}" len)
    math(EXPR after "${first}+${len}")
    string(SUBSTRING "${text}" ${after} -1 tail)
    string(FIND "${tail}" "${anchor}" second)
    if(NOT second EQUAL -1)
        message(FATAL_ERROR "H3 VSA duplicate dispatcher anchor")
    endif()
    string(REPLACE "${anchor}" "${replacement}" result "${text}")
    set(${out} "${result}" PARENT_SCOPE)
endfunction()
set(_vsa_anchor "#include \"ggml-cuda/fattn.cuh\"")
_vsa_replace_once(_vsa_text "${_vsa_text}" "${_vsa_anchor}" "${_vsa_anchor}\n#ifdef ED_ENABLE_CUDA_H3_VSA\n#include \"h3_vsa.h\"\n#endif")
set(_vsa_anchor "#ifdef ED_ENABLE_CUDA_MODULATION\n            if (ed_cuda_fused_modulate_custom_compute(dst, (ed_cuda_modulation_stream_t) ctx.stream())) {\n                break;\n            }\n#endif")
_vsa_replace_once(_vsa_text "${_vsa_text}" "${_vsa_anchor}" "${_vsa_anchor}\n#ifdef ED_ENABLE_CUDA_H3_VSA\n            if (ed_cuda_h3_vsa_compute(ctx, dst)) {\n                break;\n            }\n#endif")
set(_vsa_anchor "#ifdef ED_ENABLE_CUDA_MODULATION\n            if (ed_cuda_fused_modulate_custom_supported(op)) {\n                return true;\n            }\n#endif")
_vsa_replace_once(_vsa_text "${_vsa_text}" "${_vsa_anchor}" "${_vsa_anchor}\n#ifdef ED_ENABLE_CUDA_H3_VSA\n            if (ed_cuda_h3_vsa_supported(dev_ctx->device, op)) {\n                return true;\n            }\n#endif")
get_target_property(_vsa_sources ggml-cuda SOURCES)
get_target_property(_vsa_source_dir ggml-cuda SOURCE_DIR)
set(_vsa_count 0)
set(_vsa_new_sources)
set(_vsa_generated "${CMAKE_CURRENT_BINARY_DIR}/h3-vsa-generated/ggml-cuda.cu")
foreach(source IN LISTS _vsa_sources)
    get_filename_component(abs "${source}" ABSOLUTE BASE_DIR "${_vsa_source_dir}")
    if(abs STREQUAL _vsa_input)
        math(EXPR _vsa_count "${_vsa_count}+1")
        list(APPEND _vsa_new_sources "${_vsa_generated}")
    else()
        list(APPEND _vsa_new_sources "${source}")
    endif()
endforeach()
if(NOT _vsa_count EQUAL 1)
    message(FATAL_ERROR "H3 VSA expected one verified dispatcher, found ${_vsa_count}")
endif()
set(_vsa_write TRUE)
if(EXISTS "${_vsa_generated}")
    file(READ "${_vsa_generated}" _vsa_old)
    if(_vsa_old STREQUAL _vsa_text)
        set(_vsa_write FALSE)
    endif()
endif()
if(_vsa_write)
    file(WRITE "${_vsa_generated}" "${_vsa_text}")
endif()
set_source_files_properties("${_vsa_generated}" PROPERTIES GENERATED TRUE LANGUAGE CUDA)
set_property(TARGET ggml-cuda PROPERTY SOURCES "${_vsa_new_sources}")
target_sources(ggml-cuda PRIVATE "${CMAKE_CURRENT_LIST_DIR}/h3_vsa.cu" "${CMAKE_CURRENT_LIST_DIR}/h3_vsa_shape.cpp")
target_include_directories(ggml-cuda PRIVATE "${CMAKE_CURRENT_LIST_DIR}" "${_vsa_root}/third_party/ggml/src" "${_vsa_root}/third_party/ggml/src/ggml-cuda")
target_compile_definitions(ggml-cuda PRIVATE ED_ENABLE_CUDA_H3_VSA)
target_compile_definitions(edgedit PRIVATE ED_ENABLE_CUDA_H3_VSA)
string(SHA256 _vsa_output_sha "${_vsa_text}")
file(GENERATE OUTPUT "${CMAKE_CURRENT_BINARY_DIR}/h3-vsa-generated/provenance.txt"
    CONTENT "original=${_vsa_original}\noriginal_sha256=${_vsa_sha}\ninput_sha256=${_vsa_input_sha}\ngenerated_sha256=${_vsa_output_sha}\nsource_tree_modified=false\nhooks=include,custom_compute,custom_supports\n")
